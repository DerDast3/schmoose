# Schmoose deployment configuration
# Copy this file to .env (same directory as docker-compose.yml) and fill in
# every value. See README.md.
#
# NOTE: never commit the real .env — it contains secrets.

# ── Required ─────────────────────────────────────────────────────────────
# Public hostname of your deployment. Must match the TLS certificate
# (server_name in nginx) and is part of the OIDC redirect URI.
PUBLIC_HOST=msgs.schmoose.ms

# Database credentials
POSTGRES_PASSWORD=change-me

# First login (seed admin account); change this password after login.
ADMIN_PASSWORD=change-me

# ── Single sign-on (your OIDC provider / Keycloak realm) ────────────────
# Enable SSO login
OIDC_ENABLED=true
# The realm base URL — the "iss" claim of issued tokens must match this EXACTLY
OIDC_ISSUER=https://keycloak.example.com/realms/myrealm
# Endpoints of the same realm (Keycloak style)
OIDC_AUTH_URL=https://keycloak.example.com/realms/myrealm/protocol/openid-connect/auth
OIDC_TOKEN_URL=https://keycloak.example.com/realms/myrealm/protocol/openid-connect/token
OIDC_JWKS_URL=https://keycloak.example.com/realms/myrealm/protocol/openid-connect/certs
# The OIDC client name configured in your provider (public client, PKCE S256)
OIDC_CLIENT_ID=schmoose
# The redirect URI registered in your provider is derived automatically:
#   https://<PUBLIC_HOST>/api/auth/oidc/callback
# Override only if you need something different:
# OIDC_REDIRECT_URI=https://msgs.schmoose.ms/api/auth/oidc/callback
