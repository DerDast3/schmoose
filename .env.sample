# Schmoose deployment configuration
# Copy this file to .env (same directory as docker-compose.yml) and fill in
# every value. See README.md.
#
# NOTE: never commit the real .env — it contains secrets.

# ── Required ─────────────────────────────────────────────────────────────
# Public hostname of your deployment. Must match the TLS certificate
# (server_name in nginx) and is part of the OIDC redirect URI.
PUBLIC_HOST=msgs.schmoose.ms

# Database credentials
POSTGRES_PASSWORD=change-me

# First login (seed admin account); change this password after login.
ADMIN_PASSWORD=change-me

# ── Single sign-on (three ways — pick ONE, see README "User management") ─
#
#   1. Your own OIDC provider (Keycloak or any compliant IdP):
#      fill the block below with your provider's URLs.
#   2. The BUILT-IN IDP (simple user file, no Keycloak needed):
#      docker compose --profile idp up -d  and set the OIDC_* values to
#      your own host as shown in the commented block — then manage users
#      by editing ./userdata.json (hot-reloaded, no restart needed).
#   3. Local accounts only: set OIDC_ENABLED=false and skip the block —
#      users log in with username/email + password (+ optional TOTP).
#
# Enable SSO login (false = local password/TOTP login only)
OIDC_ENABLED=true
# Variant 2 (built-in IDP) uses your own host as the realm base —
# uncomment and adapt; variant 1 points at your provider instead:
# OIDC_ISSUER=https://msgs.schmoose.ms/realms/myrealm
# OIDC_AUTH_URL=https://msgs.schmoose.ms/realms/myrealm/protocol/openid-connect/auth
# OIDC_TOKEN_URL=https://msgs.schmoose.ms/realms/myrealm/protocol/openid-connect/token
# OIDC_JWKS_URL=https://msgs.schmoose.ms/realms/myrealm/protocol/openid-connect/certs
# Variant 1 (your own provider) example:
# OIDC_ISSUER=https://idp.example.com/realms/myrealm
# OIDC_AUTH_URL=https://idp.example.com/realms/myrealm/protocol/openid-connect/auth
# OIDC_TOKEN_URL=https://idp.example.com/realms/myrealm/protocol/openid-connect/token
# OIDC_JWKS_URL=https://idp.example.com/realms/myrealm/protocol/openid-connect/certs
# The OIDC client name configured in your provider (public client, PKCE S256)
OIDC_CLIENT_ID=schmoose
# The redirect URI registered in your provider is derived automatically:
#   https://<PUBLIC_HOST>/api/auth/oidc/callback
# Override only if you need something different:
# OIDC_REDIRECT_URI=https://msgs.schmoose.ms/api/auth/oidc/callback

# ── OIDC claim mapping (optional) ────────────────────────────────────────
# Corporate realms often use non-standard claim names. Each value is a
# comma-separated chain; the FIRST claim present in the ID token wins.
#   display name — default: name (the full name shown in chats)
#   short name (Kürzel) — default: empty; shown on avatar chips + people
#                  search. Empty = initials invented from the display name.
#   photo        — default: picture,photoUrl; the profile image (fetched
#                  for accounts without an own uploaded avatar)
#   email chain    — default: email,mail,upn
#   username chain — default: preferred_username
# If your realm uses a custom short-name claim, list it FIRST in the
# username chain so accounts are named by the short name:
# OIDC_CLAIM_DISPLAYNAME=name
# OIDC_CLAIM_SHORTNAME=shortname
# OIDC_CLAIM_EMAIL=email,mail,upn
# OIDC_CLAIM_USERNAME=shortname,preferred_username
# OIDC_CLAIM_PHOTO=picture,photoUrl

# ── Built-in IDP user file (variant 2) ───────────────────────────────────
# Copied from userdata.example.json. Each entry: login, email, password
# (initial — cleartext here, hashed automatically on the user's first
# login). Edit to add or remove users; the file is re-read on every login,
# no restart needed. Keep it private (chmod 600).
# USERDATA_FILE=./userdata.json

# ── External account console (optional) ──────────────────────────────────
# If set, the profile dialog shows a link for password changes at the
# identity provider (SSO-only accounts manage passwords there, not here).
# Leave empty to show no link.
# OIDC_ACCOUNT_URL=https://keycloak.example.com/realms/myrealm/account
